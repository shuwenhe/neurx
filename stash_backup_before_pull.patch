-                continue
-            }
-            inHeader = false
-            bodyLines.push(line)
-        }
-
-        return {
-            sourceText: sourceText,
-            modeText: modeText,
-            planText: planText,
-            bodyText: bodyLines.join("\n").trim()
-        }
-    }
