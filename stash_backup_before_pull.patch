-
-    const QFileInfoList files = dir.entryInfoList(
-        QDir::Files | QDir::Readable,
-        QDir::Name | QDir::IgnoreCase);
-    for (const QFileInfo& info : files) {
-        QString suffix = info.suffix().toUpper();
