-        return value;
-    }
-
-    static const QStringList known_suffixes = {
-        "/neurx/api/chat",
-        "/neurx/api/agent/suggest",
-        "/v1/chat/completions",
-        "/api/chat",
-        "/api/generate"
-    };
-
-    for (const QString& suffix : known_suffixes) {
-        if (value == suffix) {
-            return value;
-        }
-
-        const int idx = value.indexOf(suffix, 0, Qt::CaseInsensitive);
-        if (idx > 0) {
-            return suffix;
-        }
-    }
-
-    if (!value.startsWith('/')) {
-        value.prepend('/');
-    }
-    return value;
-}
