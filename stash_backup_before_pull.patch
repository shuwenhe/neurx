-                label = root_path;
-            } else if (label != root_path) {
-                label = QString("%1 (%2)").arg(label, root_path);
-            }
-            append_entry(label, root_path, QStringLiteral("Disk"), true);
-        }
-
-        if (entries.isEmpty()) {
-            const QFileInfoList drives = QDir::drives();
