+        if (!value.length) {
+            return ""
+        }
+        var slash = value.lastIndexOf("/")
+        var dot = value.lastIndexOf(".")
+        if (dot <= slash) {
+            return ""
+        }
+        return value.slice(dot + 1).toUpperCase()
+    }
