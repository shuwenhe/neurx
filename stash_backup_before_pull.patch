+            var field = stepMatch[1]
+            var index = stepMatch[2]
+            var value = stepMatch[3]
+            if (!stepMap[index]) {
+                stepMap[index] = {
+                    step: "",
+                    task: "",
+                    input: "",
+                    action: "",
+                    observation: "",
+                    ok: "false",
+                    active_skill: "",
+                    tool: "",
+                    tool_timeout_ms: "0",
+                    tool_retries: "0"
