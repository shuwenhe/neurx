-        return entries;
-    }
-
-    const QFileInfoList child_dirs = dir.entryInfoList(
-        QDir::Dirs | QDir::NoDotAndDotDot | QDir::Readable,
-        QDir::DirsFirst | QDir::Name | QDir::IgnoreCase);
-    for (const QFileInfo& info : child_dirs) {
