# Production optimized Dockerfile using distroless base
# 最小化生产镜像大小

# Stage 1: Builder
FROM ubuntu:22.04 as builder

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git wget curl ca-certificates pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . /app/neurx
WORKDIR /app/neurx

RUN make build-s-ir-runner && make build-production-s-inference

# Stage 2: Extract and prepare artifacts
FROM ubuntu:22.04 as artifact-extractor

WORKDIR /artifacts

COPY --from=builder /app/neurx/artifacts/build/s_runner /artifacts/s_runner
COPY --from=builder /app/neurx/artifacts/build/production_s_inference /artifacts/production_ir

RUN ls -lah /artifacts/

# Stage 3: Production runtime (distroless)
FROM gcr.io/distroless/cc-debian12:nonroot

ENV NEURX_HOME=/app/neurx \
    NEURX_MODEL_DIR=/models/default \
    NEURX_INFER_DEVICE=cpu \
    NEURX_S_PORT=8000 \
    NEURX_S_HOST=0.0.0.0 \
    PATH=/app/neurx/artifacts/build:$PATH

WORKDIR /app/neurx

COPY --from=artifact-extractor /artifacts/s_runner ./artifacts/build/
COPY --from=artifact-extractor /artifacts/production_ir ./artifacts/build/production_s_inference/

RUN mkdir -p /models/default /logs /data

COPY docker/entrypoint.sh /entrypoint.sh

EXPOSE 8000 8001 9090

VOLUME ["/models", "/logs", "/data"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["start"]
