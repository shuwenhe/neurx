ADD|t58|html|"function formatCode(src,lang){const NL=String.fromCharCode(10);let s=String(src).replaceAll(String.fromCharCode(160),' ').trim();if(s.includes(NL))return s;let out='',indent=0,paren=0,line=true,quote='',escape=false;const pad=()=> '    '.repeat(Math.max(0,indent));for(let i=0;i<s.length;i++){const c=s[i];if(quote){out+=c;if(escape)escape=false;else if(c==='\\\\\\\\')escape=true;else if(c===quote)quote='';continue}if(c==='\\"'\|\|c===\\"'\\"){quote=c;out+=c;continue}if(c==='('){paren++;out+=c;continue}if(c===')'){paren=Math.max(0,paren-1);out+=c;continue}if(c==='{'){out=out.trimEnd()+' {'+NL;indent++;out+=pad();line=true;continue}if(c==='}'){out=out.trimEnd()+NL;indent=Math.max(0,indent-1);out+=pad()+'}';if(i+1<s.length&&s[i+1]!==';'&&s[i+1]!==',')out+=NL+pad();line=true;continue}if(c===';'&&paren===0){out+=';'+NL+pad();line=true;continue}if(c==='#'&&out.trim().length>0){out=out.trimEnd()+NL+'#';line=false;continue}if(c===' '&&line)continue;out+=c;line=false}return out.trim()}\\n"
