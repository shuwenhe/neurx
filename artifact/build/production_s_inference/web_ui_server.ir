ADD|t77|html|"document.addEventListener('DOMContentLoaded',function(){const promptEl=document.getElementById('prompt');if(promptEl){promptEl.addEventListener('input',function(){autoResizeTextarea(this)});promptEl.addEventListener('keydown',function(e){console.log('Key pressed:',e.key,e.keyCode);if(e.keyCode===13\|\|e.key==='Enter'){if(!e.shiftKey){e.preventDefault();console.log('Sending request...');sendRequest();return false}else{e.preventDefault();const start=this.selectionStart,end=this.selectionEnd;this.value=this.value.substring(0,start)+String.fromCharCode(10)+this.value.substring(end);this.selectionStart=this.selectionEnd=start+1;autoResizeTextarea(this);return false}}})}checkBackend();setInterval(checkBackend,5000)})\\n"
