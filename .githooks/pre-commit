#!/bin/sh

set -eu

if [ "${NEURX_SKIP_AUTO_STAGE:-0}" = "1" ]; then
    exit 0
fi

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ "$branch" != "main" ]; then
    exit 0
fi

# Stage all changes so a plain `git commit` captures the current workspace.
git add -A

if git diff --cached --quiet; then
    exit 0
fi
