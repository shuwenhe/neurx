#!/bin/bash
# Auto-commit and push on file changes with intelligent commit messages
# This script should be run periodically or via a file watcher

STATUS=$(git status --porcelain)
if [ -n "$STATUS" ]; then
    git add -A
    
    # Get statistics about changes
    FILES_CHANGED=$(git diff --cached --name-only | tr '\n' ' ')
    STATS=$(git diff --cached --numstat | awk '{added+=$1; removed+=$2} END {print added " " removed}')
    LINES_ADDED=$(echo "$STATS" | awk '{print $1}')
    LINES_REMOVED=$(echo "$STATS" | awk '{print $2}')
    
    # Analyze changed files to determine commit type and component
    COMPONENT=""
    HAS_TRAINER=0
    HAS_EXAMPLES=0
    HAS_README=0
    HAS_MODEL=0
    HAS_CONFIG=0
    HAS_MAKEFILE=0
    
    # Extract component name if trainer file exists
    TRAINER_FILE=$(echo "$FILES_CHANGED" | grep -o "[^ ]*_trainer\.s" | head -1)
    if [ -n "$TRAINER_FILE" ]; then
        COMPONENT=$(basename "$TRAINER_FILE" _trainer.s | sed 's/_/-/g')
        HAS_TRAINER=1
    fi
    
    # Check file types
    echo "$FILES_CHANGED" | grep -q "_examples\.s" && HAS_EXAMPLES=1
    echo "$FILES_CHANGED" | grep -q "README" && HAS_README=1
    echo "$FILES_CHANGED" | grep -q "model/" && HAS_MODEL=1
    echo "$FILES_CHANGED" | grep -qi "config\|\.toml\|\.yaml" && HAS_CONFIG=1
    echo "$FILES_CHANGED" | grep -q "Makefile" && HAS_MAKEFILE=1
    
    # Generate meaningful commit message
    if [ "$HAS_TRAINER" -eq 1 ] && [ "$HAS_EXAMPLES" -eq 1 ] && [ "$HAS_README" -eq 1 ]; then
        # Complete feature implementation
        MSG="feat: implement $COMPONENT trainer with comprehensive examples and documentation ($LINES_ADDED lines)"
    elif [ "$HAS_TRAINER" -eq 1 ]; then
        # Trainer implementation/update
        MSG="feat: implement $COMPONENT trainer ($LINES_ADDED lines of production code)"
    elif [ "$HAS_EXAMPLES" -eq 1 ]; then
        # Examples for trainer
        MSG="feat: add $COMPONENT training examples ($LINES_ADDED lines)"
    elif [ "$HAS_README" -eq 1 ]; then
        # Documentation update
        README_NAME=$(echo "$FILES_CHANGED" | grep -o "README_[^ ]*" | sed 's/README_//' | sed 's/\.md//' | head -1)
        if [ -z "$README_NAME" ]; then
            MSG="docs: update documentation and guides ($LINES_ADDED lines added)"
        else
            MSG="docs: add $README_NAME documentation ($LINES_ADDED lines)"
        fi
    elif [ "$HAS_MODEL" -eq 1 ]; then
        if [ "$LINES_REMOVED" -gt 10 ]; then
            MSG="refactor: optimize model implementation ($LINES_ADDED added, $LINES_REMOVED removed)"
        else
            MSG="feat: implement model improvement ($LINES_ADDED lines)"
        fi
    elif [ "$HAS_CONFIG" -eq 1 ] && [ "$HAS_MAKEFILE" -eq 1 ]; then
        MSG="chore: update configuration and build system"
    elif [ "$HAS_CONFIG" -eq 1 ]; then
        MSG="feat: update configuration and parameters"
    elif [ "$HAS_MAKEFILE" -eq 1 ]; then
        MSG="chore: update Makefile and build targets"
    else
        # Fallback: generic message with line count
        if [ "$LINES_ADDED" -gt 500 ]; then
            MSG="feat: major implementation update ($LINES_ADDED lines added)"
        elif [ "$LINES_ADDED" -gt 100 ]; then
            MSG="feat: add functionality ($LINES_ADDED lines)"
        else
            MSG="feat: update code ($LINES_ADDED added, $LINES_REMOVED removed)"
        fi
    fi
    
    git commit -m "$MSG" 2>/dev/null && \
    git push origin main 2>/dev/null
fi
