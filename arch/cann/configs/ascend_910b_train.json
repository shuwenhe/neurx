{
  "name": "neurx-ascend-910b-training",
  "mode": "train",
  "target": {
    "soc": "Ascend910B1"
  },
  "env": {
    "ASCEND_RT_VISIBLE_DEVICES": "0"
  },
  "train": {
    "workdir": "/app/neurx",
    "command": [
      "python3",
      "cann/example/torch_npu_train_template.py",
      "--epochs",
      "2",
      "--batch-size",
      "8"
    ]
  }
}