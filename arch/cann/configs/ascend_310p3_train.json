{
  "name": "neurx-ascend-310p3-8card-training",
  "mode": "train",
  "target": {
    "soc": "Ascend310P3"
  },
  "allow_train_on_310p3": true,
  "env": {
    "ASCEND_RT_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
    "HCCL_CONNECT_TIMEOUT": "7200"
  },
  "train": {
    "workdir": "/app/neurx",
    "command": [
      "python3",
      "-m",
      "torch.distributed.run",
      "--nproc_per_node",
      "8",
      "--master_port",
      "29530",
      "arch/cann/example/torch_npu_train_template.py",
      "--epochs",
      "1",
      "--steps-per-epoch",
      "20",
      "--batch-size",
      "8",
      "--device",
      "npu"
    ]
  }
}
