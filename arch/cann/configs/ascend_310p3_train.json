{
  "name": "neurx-ascend-310p3-8card-training",
  "mode": "infer",
  "target": {
    "soc": "Ascend310P3"
  },
  "allow_train_on_310p3": true,
  "env": {
    "ASCEND_RT_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
    "HCCL_CONNECT_TIMEOUT": "7200"
  },
  "train": {
    "workdir": "/app/neurx",
    "command": [
      "s",
      "serving/serve/serve.s"
    ]
  }
}
