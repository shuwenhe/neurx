{
  "id": "org.neurx.plugin.example",
  "name": "Example Plugin",
  "version": "1.0.0",
  "description": "Example plugin demonstrating plugin structure",
  "author": "neurx team",
  "license": "MIT",
  "mainFile": "libexample-plugin.so",
  "entryPoint": "initPlugin",
  "category": "tool",
  "homepage": "https://github.com/neurx/plugin-example",
  "repository": "https://github.com/neurx/plugin-example.git",
  
  "capabilities": {
    "tools": ["example-tool"],
    "models": [],
    "skills": ["example-skill"],
    "permissions": ["read:files", "write:logs"]
  },
  
  "dependencies": [],
  
  "defaultConfig": {
    "enabled": true,
    "timeout": 30000,
    "maxRetries": 3
  },
  
  "requiredPermissions": [
    "read:files",
    "execute:shell"
  ],
  
  "supportedPlatforms": ["linux", "macos", "windows"],
  "minNeurxVersion": "1.0.0",
  "requiresRestart": false,
  "sandboxed": true,
  "trusted": false
}
