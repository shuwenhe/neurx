{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/**",
                "/opt/homebrew/opt/qt@6/include",
                "/opt/homebrew/opt/qt@6/include/QtCore",
                "/opt/homebrew/opt/qt@6/include/QtGui",
                "/opt/homebrew/opt/qt@6/include/QtQml",
                "/opt/homebrew/opt/qt@6/include/QtQuick",
                "/opt/homebrew/opt/qt@6/include/QtNetwork",
                "/opt/homebrew/opt/qt@6/include/QtConcurrent",
                "/opt/homebrew/opt/qt@6/include/QtTest",
                "/opt/homebrew/include",
                "/usr/local/include",
                "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/include/c++/v1"
            ],
            "defines": [
                "QT_CORE_LIB",
                "QT_GUI_LIB",
                "QT_QML_LIB",
                "QT_QUICK_LIB",
                "QT_NETWORK_LIB"
            ],
            "macFrameworkPath": [
                "/System/Library/Frameworks",
                "/Library/Frameworks",
                "/opt/homebrew/opt/qt@6/lib"
            ],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64",
            "configurationProvider": "ms-vscode.cmake-tools",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}
