index 000000000..0379aaa25
--- /dev/null
+++ b/test/native-bootstrap-diagnostic/test_seed_string_index.py
@@ -0,0 +1,48 @@
+"""String indexing has the same unsigned-byte type in seed analysis and execution."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+SEED = ROOT / 'bin/s_seed'
+
+
+class SeedStringIndex(unittest.TestCase):
+    def compile(self, source, folder):
+        entry = folder / 'main.s'
+        entry.write_text(source)
+        return subprocess.run([str(SEED), '--compile-unit', str(folder / 'main.ir'), str(entry)],
+                              capture_output=True, text=True, timeout=30, cwd=ROOT)
+
+    def test_byte_index_passes_integer_parameter_and_executes(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            folder = Path(temporary)
+            result = self.compile('''package main
+func identity(int value) int { return value }
+func main() int {
+    string text = "A9"
+    if identity(text[0]) != 65 { return 1 }
+    if text[1] != 57 { return 2 }
+    if identity("é"[0]) != 195 { return 3 }
+    return 0
+}
+''', folder)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            result = subprocess.run([str(SEED), '--emit-standalone-amd64', str(folder / 'main.ir'), str(folder / 'main')], capture_output=True, text=True, timeout=30, cwd=ROOT)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+            result = subprocess.run([str(folder / 'main')], capture_output=True, text=True, timeout=10)
+            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+
+    def test_byte_index_is_rejected_for_string_parameter(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            result = self.compile('''package main
+func consume(string value) int { return len(value) }
+func main() int { string text = "A"; return consume(text[0]) }
+''', Path(temporary))
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn("expected 'string', got 'int'", result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
