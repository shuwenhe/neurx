{
  "name": "neurx-ascend-310p3-8worker-inference",
  "mode": "infer",
  "target": {
    "soc": "Ascend310P3"
  },
  "env": {
    "ASCEND_RT_VISIBLE_DEVICES": "0,1,2,3,4,5,6,7",
    "NEURX_ASCEND_PRECISION": "int8",
    "NEURX_ASCEND_WORKER_COUNT": "8"
  },
  "serve": {
    "workdir": "/app/neurx",
    "command": [
      "bash",
      "cann/scripts/launch_8card_310p3_inference.sh"
    ]
  }
}
