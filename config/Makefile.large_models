.PHONY: train-large train-large-watch train-xlarge train-xlarge-watch \
        train-tensor train-tensor-watch train-pipeline train-pipeline-watch \
        train-dist train-dist-watch \
        infer-batch infer-batch-watch infer-stream infer-serving \
        finetune finetune-watch eval eval-watch benchmark \
        setup-distributed setup-kubernetes setup-slurm \
        monitor logs clean-logs train-help infer-help

train-large: check-bash
	@echo "🚀 Running Large Model Training (7B-13B parameters)"
	@echo "   GPU: 8×A100-40GB | Time: 1-2 days | Memory: 320GB"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-5000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	export NEURX_LR="$${NEURX_LR:-0.00005}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-4096}"; \
	export NEURX_WARMUP_STEPS="$${NEURX_WARMUP_STEPS:-500}"; \
	export NEURX_CHECKPOINT_INTERVAL="$${NEURX_CHECKPOINT_INTERVAL:-100}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-8}"; \
	export NEURX_DATA_PARALLEL_SIZE="$${NEURX_DATA_PARALLEL_SIZE:-4}"; \
	export NEURX_TENSOR_PARALLEL_SIZE="$${NEURX_TENSOR_PARALLEL_SIZE:-2}"; \
	export NEURX_PIPELINE_PARALLEL_SIZE="$${NEURX_PIPELINE_PARALLEL_SIZE:-1}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	export NEURX_LOSS_SCALE="$${NEURX_LOSS_SCALE:-1.0}"; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	if [ $$STATUS -eq 0 ]; then \
		echo "✅ Large model training completed successfully!"; \
		echo "   Checkpoints: artifacts/checkpoints/llm_training/"; \
	else \
		echo "❌ Large model training failed with exit code $$STATUS"; \
	fi; \
	exit $$STATUS

train-large-watch: check-bash
	@echo "🚀 Running Large Model Training with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p .run && \
	LOG_FILE="/tmp/neurx_large_train.log" && \
	rm -f "$$LOG_FILE" && \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-5000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	export NEURX_LR="$${NEURX_LR:-0.00005}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-4096}"; \
	export NEURX_WARMUP_STEPS="$${NEURX_WARMUP_STEPS:-500}"; \
	export NEURX_CHECKPOINT_INTERVAL="$${NEURX_CHECKPOINT_INTERVAL:-100}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-8}"; \
	export NEURX_DATA_PARALLEL_SIZE="$${NEURX_DATA_PARALLEL_SIZE:-4}"; \
	export NEURX_TENSOR_PARALLEL_SIZE="$${NEURX_TENSOR_PARALLEL_SIZE:-2}"; \
	export NEURX_PIPELINE_PARALLEL_SIZE="$${NEURX_PIPELINE_PARALLEL_SIZE:-1}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	$(MAKE) run-large-pretrain-s 2>&1 | tee "$$LOG_FILE" & \
	TRAIN_PID=$$!; \
	echo "$$TRAIN_PID" > .run/train_large_watch_pid.txt; \
	sleep 0.5; \
	echo "📊 Tailing $$LOG_FILE (PID: $$TRAIN_PID)"; \
	tail --pid=$$TRAIN_PID -F "$$LOG_FILE"; \
	wait $$TRAIN_PID; STATUS=$$?; \
	rm -f .run/train_large_watch_pid.txt; \
	exit $$STATUS

train-xlarge: check-bash
	@echo "🚀 Running XLarge Model Training (70B+ parameters - NeurX Scale)"
	@echo "   GPU: 32×A100-40GB | Time: 1-4 weeks | Memory: 1.2TB"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-100000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	export NEURX_LR="$${NEURX_LR:-0.00005}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-8192}"; \
	export NEURX_WARMUP_STEPS="$${NEURX_WARMUP_STEPS:-5000}"; \
	export NEURX_CHECKPOINT_INTERVAL="$${NEURX_CHECKPOINT_INTERVAL:-500}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-32}"; \
	export NEURX_DATA_PARALLEL_SIZE="$${NEURX_DATA_PARALLEL_SIZE:-2}"; \
	export NEURX_TENSOR_PARALLEL_SIZE="$${NEURX_TENSOR_PARALLEL_SIZE:-8}"; \
	export NEURX_PIPELINE_PARALLEL_SIZE="$${NEURX_PIPELINE_PARALLEL_SIZE:-2}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	export NEURX_LOSS_SCALE="$${NEURX_LOSS_SCALE:-65536.0}"; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	if [ $$STATUS -eq 0 ]; then \
		echo "✅ XLarge model training completed!"; \
		echo "   Checkpoints: artifacts/checkpoints/llm_training/"; \
	else \
		echo "❌ XLarge model training failed with exit code $$STATUS"; \
	fi; \
	exit $$STATUS

