train-tensor: check-bash
	@echo "🚀 Tensor Parallelism Training (weight matrix distribution)"
	@echo "   GPU: 8-16×A100-40GB | Model: 20B-70B parameters"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-10000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-16}"; \
	export NEURX_LR="$${NEURX_LR:-0.00005}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-4096}"; \
	export NEURX_WARMUP_STEPS="$${NEURX_WARMUP_STEPS:-1000}"; \
	export NEURX_CHECKPOINT_INTERVAL="$${NEURX_CHECKPOINT_INTERVAL:-200}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-8}"; \
	export NEURX_DATA_PARALLEL_SIZE="$${NEURX_DATA_PARALLEL_SIZE:-1}"; \
	export NEURX_TENSOR_PARALLEL_SIZE="$${NEURX_TENSOR_PARALLEL_SIZE:-8}"; \
	export NEURX_PIPELINE_PARALLEL_SIZE="$${NEURX_PIPELINE_PARALLEL_SIZE:-1}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	exit $$STATUS

train-tensor-watch: check-bash
	@echo "🚀 Tensor Parallelism Training with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p .run && \
	LOG_FILE="/tmp/neurx_tensor_train.log" && \
	rm -f "$$LOG_FILE" && \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-10000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-16}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-8}"; \
	export NEURX_TENSOR_PARALLEL_SIZE="$${NEURX_TENSOR_PARALLEL_SIZE:-8}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	$(MAKE) run-large-pretrain-s 2>&1 | tee "$$LOG_FILE" & \
	TRAIN_PID=$$!; \
	echo "$$TRAIN_PID" > .run/train_tensor_watch_pid.txt; \
	sleep 0.5; \
	echo "📊 Tailing $$LOG_FILE"; \
	tail --pid=$$TRAIN_PID -F "$$LOG_FILE"; \
	wait $$TRAIN_PID; STATUS=$$?; \
	rm -f .run/train_tensor_watch_pid.txt; \
	exit $$STATUS

train-pipeline: check-bash
	@echo "🚀 Pipeline Parallelism Training (layer distribution)"
	@echo "   GPU: 16×A100-40GB | Model: 70B-175B parameters"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-50000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-8}"; \
	export NEURX_LR="$${NEURX_LR:-0.00005}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-8192}"; \
	export NEURX_WARMUP_STEPS="$${NEURX_WARMUP_STEPS:-5000}"; \
	export NEURX_CHECKPOINT_INTERVAL="$${NEURX_CHECKPOINT_INTERVAL:-500}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-16}"; \
	export NEURX_DATA_PARALLEL_SIZE="$${NEURX_DATA_PARALLEL_SIZE:-2}"; \
	export NEURX_TENSOR_PARALLEL_SIZE="$${NEURX_TENSOR_PARALLEL_SIZE:-2}"; \
	export NEURX_PIPELINE_PARALLEL_SIZE="$${NEURX_PIPELINE_PARALLEL_SIZE:-4}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	exit $$STATUS

train-pipeline-watch: check-bash
	@echo "🚀 Pipeline Parallelism Training with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p .run && \
	LOG_FILE="/tmp/neurx_pipeline_train.log" && \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-16}"; \
	export NEURX_PIPELINE_PARALLEL_SIZE="$${NEURX_PIPELINE_PARALLEL_SIZE:-4}"; \
	$(MAKE) run-large-pretrain-s 2>&1 | tee "$$LOG_FILE" & \
	TRAIN_PID=$$!; \
	echo "$$TRAIN_PID" > .run/train_pipeline_watch_pid.txt; \
	sleep 0.5; \
	tail --pid=$$TRAIN_PID -F "$$LOG_FILE"; \
	wait $$TRAIN_PID; STATUS=$$?; \
	rm -f .run/train_pipeline_watch_pid.txt; \
	exit $$STATUS

train-dist: check-bash
	@echo "🚀 Distributed Multi-Node Training"
	@echo "   Nodes: $${NEURX_NUM_NODES:-4} | Total GPUs: $${NEURX_WORLD_SIZE:-32}"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_NUM_NODES="$${NEURX_NUM_NODES:-4}"; \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-32}"; \
	export NEURX_RANK="$${NEURX_RANK:-0}"; \
	export NEURX_MASTER_ADDR="$${NEURX_MASTER_ADDR:-localhost}"; \
	export NEURX_MASTER_PORT="$${NEURX_MASTER_PORT:-29500}"; \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-100000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-4096}"; \
	export NEURX_MIXED_PRECISION_MODE="$${NEURX_MIXED_PRECISION_MODE:-bf16}"; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	exit $$STATUS

train-dist-watch: check-bash
	@echo "🚀 Distributed Training with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p .run && \
	LOG_FILE="/tmp/neurx_dist_train.log" && \
	export NEURX_WORLD_SIZE="$${NEURX_WORLD_SIZE:-32}"; \
	$(MAKE) run-large-pretrain-s 2>&1 | tee "$$LOG_FILE" & \
	TRAIN_PID=$$!; \
	echo "$$TRAIN_PID" > .run/train_dist_watch_pid.txt; \
	tail --pid=$$TRAIN_PID -F "$$LOG_FILE"; \
	wait $$TRAIN_PID; STATUS=$$?; \
	rm -f .run/train_dist_watch_pid.txt; \
	exit $$STATUS

infer-batch: check-bash
	@echo "🔮 Running Batch Inference"
	@echo "   Mode: Batch processing | Input: prompts file"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_INFER_MODE="batch"; \
	export NEURX_INFER_BATCH_FILE="$${NEURX_INFER_BATCH_FILE:-data/prompts.txt}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	export NEURX_TEMPERATURE="$${NEURX_TEMPERATURE:-0.7}"; \
	export NEURX_TOP_K="$${NEURX_TOP_K:-40}"; \
	export NEURX_TOP_P="$${NEURX_TOP_P:-0.9}"; \
	$(MAKE) run-full-inference-s 2>&1; \
	STATUS=$$?; \
	if [ $$STATUS -eq 0 ]; then \
		echo "✅ Batch inference completed! Output: artifacts/inference_output/"; \
	else \
		echo "❌ Batch inference failed"; \
	fi; \
	exit $$STATUS

infer-batch-watch: check-bash
	@echo "🔮 Batch Inference with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	LOG_FILE="/tmp/neurx_infer_batch.log" && \
	export NEURX_INFER_MODE="batch"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	$(MAKE) run-full-inference-s 2>&1 | tee "$$LOG_FILE"; \
	STATUS=$$?; \
	exit $$STATUS

infer-stream: check-bash
	@echo "🔮 Running Streaming Inference"
	@echo "   Mode: Real-time token streaming | Latency: optimized"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_INFER_MODE="stream"; \
	export NEURX_STREAM_CHUNK_SIZE="$${NEURX_STREAM_CHUNK_SIZE:-32}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-1}"; \
	export NEURX_TEMPERATURE="$${NEURX_TEMPERATURE:-0.7}"; \
	$(MAKE) run-full-inference-s 2>&1; \
	STATUS=$$?; \
	exit $$STATUS

infer-serving: check-bash
	@echo "🔮 Running Inference Server"
	@echo "   Mode: Production serving | Port: 8000"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_INFER_MODE="serving"; \
	export NEURX_SERVE_PORT="$${NEURX_SERVE_PORT:-8000}"; \
	export NEURX_SERVE_HOST="$${NEURX_SERVE_HOST:-0.0.0.0}"; \
	export NEURX_SERVE_WORKERS="$${NEURX_SERVE_WORKERS:-4}"; \
	echo "🚀 Server starting on http://$${NEURX_SERVE_HOST}:$${NEURX_SERVE_PORT}"; \
	echo "📝 API endpoints:"; \
	echo "   POST /generate - Generate text"; \
	echo "   GET /health - Health check"; \
	$(MAKE) run-full-inference-s 2>&1; \
	STATUS=$$?; \
	exit $$STATUS

finetune: check-bash
	@echo "🎯 Running Fine-tuning"
	@echo "   Mode: Supervised fine-tuning | Adapter: LoRA"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_FINETUNE_MODE="true"; \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-1000}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-8}"; \
	export NEURX_LR="$${NEURX_LR:-0.0001}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-2048}"; \
	export NEURX_LORA_RANK="$${NEURX_LORA_RANK:-8}"; \
	export NEURX_LORA_ALPHA="$${NEURX_LORA_ALPHA:-16}"; \
	export NEURX_CHECKPOINT_PATH="$${NEURX_CHECKPOINT_PATH:-artifacts/checkpoints/llm_training/}"; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	exit $$STATUS

finetune-watch: check-bash
	@echo "🎯 Fine-tuning with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p .run && \
	LOG_FILE="/tmp/neurx_finetune.log" && \
	export NEURX_FINETUNE_MODE="true"; \
	export NEURX_TOTAL_STEPS="$${NEURX_TOTAL_STEPS:-1000}"; \
	$(MAKE) run-large-pretrain-s 2>&1 | tee "$$LOG_FILE" & \
	TRAIN_PID=$$!; \
	echo "$$TRAIN_PID" > .run/finetune_watch_pid.txt; \
	tail --pid=$$TRAIN_PID -F "$$LOG_FILE"; \
	wait $$TRAIN_PID; STATUS=$$?; \
	rm -f .run/finetune_watch_pid.txt; \
	exit $$STATUS

eval: check-bash
	@echo "📊 Running Model Evaluation"
	@echo "   Metrics: Perplexity, BLEU, F1"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_EVAL_MODE="true"; \
	export NEURX_CHECKPOINT_PATH="$${NEURX_CHECKPOINT_PATH:-artifacts/checkpoints/llm_training/}"; \
	$(MAKE) run-full-inference-s 2>&1; \
	STATUS=$$?; \
	echo "✅ Evaluation completed. Results: artifacts/eval_results/"; \
	exit $$STATUS

eval-watch: check-bash
	@echo "📊 Evaluation with Live Logs"
	@cd '$(CURDIR_UNIX)' && \
	LOG_FILE="/tmp/neurx_eval.log" && \
	export NEURX_EVAL_MODE="true"; \
	$(MAKE) run-full-inference-s 2>&1 | tee "$$LOG_FILE"; \
	STATUS=$$?; \
	exit $$STATUS

benchmark: check-bash
	@echo "⚡ Running Performance Benchmark"
	@echo "   Metrics: Throughput, Latency, Memory"
	@cd '$(CURDIR_UNIX)' && \
	export NEURX_BENCHMARK_MODE="true"; \
	export NEURX_BENCHMARK_STEPS="$${NEURX_BENCHMARK_STEPS:-100}"; \
	export NEURX_BATCH_SIZE="$${NEURX_BATCH_SIZE:-32}"; \
	export NEURX_SEQ_LENGTH="$${NEURX_SEQ_LENGTH:-2048}"; \
	echo "🚀 Benchmarking started..."; \
	$(MAKE) run-large-pretrain-s 2>&1; \
	STATUS=$$?; \
	echo "✅ Benchmark completed. Report: artifacts/benchmark_report/"; \
	exit $$STATUS

setup-distributed: check-bash
	@echo "🔧 Setting up Distributed Training Environment"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p artifacts/distributed_config && \
	echo "export NEURX_MASTER_ADDR=localhost" > artifacts/distributed_config/env.sh && \
	echo "export NEURX_MASTER_PORT=29500" >> artifacts/distributed_config/env.sh && \
	echo "export NEURX_WORLD_SIZE=$${NEURX_WORLD_SIZE:-4}" >> artifacts/distributed_config/env.sh && \
	echo "export NEURX_RANK=\$$RANK" >> artifacts/distributed_config/env.sh && \
	chmod +x artifacts/distributed_config/env.sh && \
	echo "✅ Distributed environment configured"; \
	echo "   Run: source artifacts/distributed_config/env.sh"; \
	echo "   Then: make train-dist"

setup-kubernetes: check-bash
	@echo "🐳 Setting up Kubernetes Deployment"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p artifacts/kubernetes && \
	echo "Creating Kubernetes manifests..." && \
	echo "✅ Kubernetes setup completed"; \
	echo "   Deploy: kubectl apply -f artifacts/kubernetes/"; \
	echo "   Check: kubectl get pods"

setup-slurm: check-bash
	@echo "🖥️  Setting up SLURM Job Script"
	@cd '$(CURDIR_UNIX)' && \
	mkdir -p artifacts/slurm && \
	echo "Creating SLURM job scripts..." && \
	echo "✅ SLURM setup completed"; \
	echo "   Submit: sbatch artifacts/slurm/train_job.sh"

monitor: check-bash
	@echo "📡 Monitoring Training"
	@if [ -f "/tmp/neurx_llm_train.log" ]; then \
		echo "🔍 Recent logs from /tmp/neurx_llm_train.log:"; \
		echo ""; \
		tail -20 /tmp/neurx_llm_train.log; \
	else \
		echo "❌ No training logs found"; \
		echo "   Run: make train-llm or make train-llm-watch first"; \
	fi

logs: check-bash
	@echo "📋 Training Logs"
	@ls -lh /tmp/neurx*.log 2>/dev/null || echo "No logs found"

clean-logs: check-bash
	@echo "🧹 Cleaning up logs"
	@rm -f /tmp/neurx*.log
	@rm -rf .run/
	@echo "✅ Logs cleaned"

train-help: check-bash
	@echo "=== NeurX Training Commands ==="
	@echo ""
	@echo "Quick Training:"
	@echo "  make train-llm NEURX_TOTAL_STEPS=10    # Quick test (5 min)"
	@echo ""
	@echo "Scale-based Training:"
	@echo "  make train-large                        # 7B-13B model (1-2 days, 8 GPUs)"
	@echo "  make train-xlarge                       # 70B+ model (1-4 weeks, 32 GPUs)"
	@echo ""
	@echo "Parallelization:"
	@echo "  make train-tensor                       # Tensor parallel (weight sharding)"
	@echo "  make train-pipeline                     # Pipeline parallel (layer sharding)"
	@echo "  make train-dist                         # Multi-node distributed"
	@echo ""
	@echo "Monitoring:"
	@echo "  make train-large-watch                  # Training with live logs"
	@echo "  make monitor                            # View current training status"
	@echo "  make logs                               # List all log files"
	@echo ""
	@echo "Configuration Examples:"
	@echo "  NEURX_TOTAL_STEPS=1000                 # Total training steps"
	@echo "  NEURX_BATCH_SIZE=32                    # Batch size"
	@echo "  NEURX_LR=0.00005                       # Learning rate"
	@echo "  NEURX_SEQ_LENGTH=4096                  # Sequence length"
	@echo "  NEURX_WORLD_SIZE=8                     # Total GPUs"
	@echo "  NEURX_MIXED_PRECISION_MODE=bf16        # BF16/FP16/FP32"
	@echo ""

infer-help: check-bash
	@echo "=== NeurX Inference Commands ==="
	@echo ""
	@echo "Interactive (REPL):"
	@echo "  make infer-interactive                  # Multi-turn chat"
	@echo ""
	@echo "Batch Processing:"
	@echo "  make infer-batch                        # Process multiple prompts"
	@echo "  make infer-batch-watch                  # Batch with logs"
	@echo ""
	@echo "Streaming & Serving:"
	@echo "  make infer-stream                       # Real-time token streaming"
	@echo "  make infer-serving                      # Production inference server"
	@echo ""
	@echo "Configuration:"
	@echo "  NEURX_TEMPERATURE=0.7                  # Sampling temperature"
	@echo "  NEURX_TOP_K=40                         # Top-K sampling"
	@echo "  NEURX_TOP_P=0.9                        # Nucleus sampling"
