{
  "model_name": "neurx-7b",
  "model_type": "transformer",
  "num_parameters": 7000000000,
  "hidden_size": 4096,
  "num_hidden_layers": 32,
  "num_attention_heads": 32,
  "intermediate_size": 14336,
  "vocab_size": 128000,
  "max_position_embeddings": 32768,
  "rope_theta": 10000.0,
  "attention_dropout": 0.0,
  "hidden_dropout_prob": 0.0,
  "initializer_range": 0.02,
  "layer_norm_eps": 1e-6,
  "use_cache": true,
  "torch_dtype": "float16",
  "pretraining_tp": 1,
  "output_attentions": false,
  "output_hidden_states": false,
  "transformers_version": "4.30.0",
  "training": {
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "learning_rate": 5e-4,
    "lr_scheduler_type": "cosine",
    "warmup_steps": 1000,
    "num_training_steps": 100000,
    "max_grad_norm": 1.0,
    "weight_decay": 0.01,
    "adam_epsilon": 1e-8,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "save_steps": 5000,
    "logging_steps": 100,
    "eval_steps": 500,
    "save_total_limit": 3,
    "load_best_model_at_end": true,
    "metric_for_best_model": "eval_loss",
    "greater_is_better": false,
    "seed": 42
  },
  "optimization": {
    "mixed_precision": {
      "enabled": true,
      "dtype": "fp16",
      "loss_scale": 1024.0,
      "dynamic_loss_scale": true,
      "dynamic_loss_scale_window": 100
    },
    "activation_checkpointing": {
      "enabled": true,
      "checkpoint_strategy": "every_other",
      "memory_savings_percent": 40.0
    },
    "flash_attention": {
      "enabled": true,
      "memory_efficient": true
    },
    "fused_operations": {
      "enabled": true,
      "fused_adamw": true,
      "fused_layer_norm": true
    }
  },
  "distributed": {
    "backend": "nccl",
    "world_size": 4,
    "rank": 0,
    "master_addr": "localhost",
    "master_port": 29500,
    "timeout_minutes": 30,
    "zero_stage": 1,
    "zero_config": {
      "stage": 1,
      "offload_optimizer": false,
      "offload_param": false,
      "reduce_bucket_size": 2e8,
      "stage3_max_live_parameters": 2e9,
      "stage3_max_reuse_distance": 2e9,
      "stage3_gather_16bit_weights_on_model_save": true
    },
    "tensor_parallel_size": 1,
    "pipeline_parallel_stages": 1,
    "data_parallel_size": 4,
    "gradient_as_bucket_view": true,
    "find_unused_parameters": false,
    "sync_gradients": true
  },
  "data": {
    "dataset_name": "wikitext",
    "dataset_config": "wikitext-103-v1",
    "split": "train",
    "preprocessing_num_workers": 4,
    "max_seq_length": 4096,
    "cache_dataset": true,
    "preprocessing_only": false,
    "validation_split": 0.05,
    "streaming": true,
    "shuffle": true,
    "seed": 42,
    "dataset_root": "dataset/pretrain",
    "manifest_path": "dataset/pretrain/manifest.json",
    "train_manifest_path": "dataset/pretrain/manifest.json",
    "val_manifest_path": "dataset/pretrain/manifest.json",
    "test_manifest_path": "dataset/pretrain/manifest.json",
    "shard_dir": "dataset/pretrain/shard",
    "shard_manifest_path": "dataset/pretrain/manifest.json",
    "reshard_on_start": true,
    "epoch_sampling": true,
    "shuffle_buffer_size": 10000,
    "tokenizer_name": "neurx-bpe",
    "tokenizer_model_path": "src/inference/extensions/tokenizer/neurx_bpe_128k.model",
    "tokenizer_merges_path": "src/inference/extensions/tokenizer/neurx_bpe_128k.merges",
    "tokenizer_vocab_path": "src/inference/extensions/tokenizer/neurx_bpe_128k.vocab",
    "tokenizer_manifest_path": "src/training/data/tokenizer.manifest"
  },
  "checkpoint": {
    "save_path": "checkpoints/neurx-7b",
    "save_strategy": "steps",
    "resume_from_checkpoint": "checkpoints/neurx-7b/latest",
    "save_safetensors": true,
    "save_optimizer_state": true,
    "save_rng_state": true,
    "save_sharded_optimizer_state": true,
    "sharded_optimizer_prefix": "optimizer_shard",
    "checkpoint_format": "sharded",
    "checkpoint_validation_enabled": true,
    "resume_strict": true,
    "keep_last": 3,
    "save_best_only": false,
    "latest_checkpoint_file": "checkpoints/neurx-7b/latest_checkpoint.txt"
  },
  "logging": {
    "output_dir": "logs",
    "log_level": "info",
    "logging_first_step": true,
    "report_to": ["tensorboard"],
    "push_to_hub": false,
    "metrics_dir": "logs/metrics",
    "checkpoint_audit_dir": "logs/checkpoint_audit",
    "startup_report_file": "logs/startup_report.json"
  },
  "memory_estimate": {
    "model_weights_gb": 27.0,
    "gradients_gb": 27.0,
    "optimizer_states_gb": 14.0,
    "activations_gb": 8.0,
    "safety_margin_gb": 9.0,
    "total_gb_per_gpu": 85.0,
    "total_gb_all_gpus": 340.0,
    "with_optimizations_gb_per_gpu": 35.0,
    "notes": "Values calculated for batch_size=8, seq_len=4096, 4×H100 setup"
  },
  "performance_expectations": {
    "tokens_per_second": 1000,
    "steps_per_hour": 300,
    "training_duration_days": 14,
    "expected_convergence_steps": 50000,
    "target_perplexity": 15.0,
    "baseline_perplexity": 35.7
  },
  "validation": {
    "eval_dataset_size": 10000,
    "benchmark_datasets": ["mmlu", "hellaswag", "arc"],
    "validation_frequency": 500
  }
}
