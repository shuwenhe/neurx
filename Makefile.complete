# ============================================
# NeurX Enhanced Makefile - Complete Training Pipeline
# Integrates: Monitoring + Perplexity + AMP + LR Schedule + Distributed
# ============================================

.PHONY: help build train train-full train-amp train-distributed demo test clean

# Configuration
S_COMPILER ?= s
PYTHON ?= python3
BASH := bash
PROJECT_ROOT := $(shell pwd)
BIN_DIR := $(PROJECT_ROOT)/bin
SCRIPT_DIR := $(PROJECT_ROOT)/script
CHECKPOINT_DIR := $(PROJECT_ROOT)/artifacts/checkpoints
LOG_DIR := $(PROJECT_ROOT)/logs
CONFIG_FILE := $(PROJECT_ROOT)/config_large_model.json

# Features
ENABLE_AMP ?= 1
ENABLE_LR_SCHEDULE ?= 1
ENABLE_GRADIENT_CLIP ?= 1
ENABLE_DISTRIBUTED ?= 0
ENABLE_MONITORING ?= 1

# Distributed training
WORLD_SIZE ?= 1
RANK ?= 0
MASTER_ADDR ?= localhost
MASTER_PORT ?= 29500

# Colors
RED := \033[0;31m
GREEN := \033[0;32m
YELLOW := \033[1;33m
BLUE := \033[0;34m
CYAN := \033[0;36m
NC := \033[0m

# ============================================
# Help
# ============================================

help:
	@echo "$(CYAN)╔════════════════════════════════════════════════════════╗$(NC)"
	@echo "$(CYAN)║  NeurX Complete Training System with Full Pipeline     ║$(NC)"
	@echo "$(CYAN)╚════════════════════════════════════════════════════════╝$(NC)"
	@echo ""
	@echo "$(GREEN)🚀 Quick Start:$(NC)"
	@echo "  make train-full              ← Start complete training"
	@echo "  make demo all                ← See all features in action"
	@echo ""
	@echo "$(YELLOW)📚 Feature Demos:$(NC)"
	@echo "  make demo-perplexity         - Perplexity tracking"
	@echo "  make demo-amp                - Mixed precision training"
	@echo "  make demo-lr                 - Learning rate schedule"
	@echo "  make demo-gradient           - Gradient management"
	@echo "  make demo-monitor            - Real-time monitoring"
	@echo "  make demo-distributed        - Multi-GPU training"
	@echo "  make demo-checkpoint         - Checkpoint management"
	@echo "  make demo-report             - Convergence report"
	@echo ""
	@echo "$(BLUE)🔨 Build & Setup:$(NC)"
	@echo "  make build                   - Build all tools"
	@echo "  make build-monitor           - Build advanced monitor"
	@echo "  make build-amp               - Build AMP trainer"
	@echo "  make build-distributed       - Build distributed trainer"
	@echo ""
	@echo "🎯 Advanced Training:$(NC)"
	@echo "  make train                   - Standard training"
	@echo "  make train-amp               - With AMP enabled"
	@echo "  make train-distributed       - Multi-GPU training"
	@echo "  make train-with-profile      - With profiling"
	@echo ""
	@echo "📊 Analysis:$(NC)"
	@echo "  make eval                    - Evaluate model"
	@echo "  make report                  - Generate report"
	@echo "  make analyze-ppl             - Analyze perplexity"
	@echo ""
	@echo "🔧 Management:$(NC)"
	@echo "  make checkpoint-list         - List checkpoints"
	@echo "  make checkpoint-cleanup      - Clean old checkpoints"
	@echo "  make test                    - Run tests"
	@echo "  make clean                   - Clean build files"
	@echo ""

# ============================================
# Directories & Setup
# ============================================

dirs:
	@mkdir -p $(BIN_DIR) $(LOG_DIR) $(CHECKPOINT_DIR)
	@echo "$(GREEN)✓ Directories created$(NC)"

# ============================================
# Build Targets
# ============================================

build: dirs
	@echo "$(BLUE)🔨 Building all components...$(NC)"
	@$(MAKE) build-monitor
	@$(MAKE) build-amp
	@$(MAKE) build-distributed
	@echo "$(GREEN)✓ Build complete$(NC)"

build-monitor: dirs
	@echo "  Building advanced monitor..."
	@if command -v $(S_COMPILER) > /dev/null; then \
		$(S_COMPILER) build $(SCRIPT_DIR)/advanced_monitor.s -o $(BIN_DIR)/advanced_monitor 2>/dev/null || echo "    ⚠ Monitor build skipped (using bash fallback)"; \
	fi

build-amp: dirs
	@echo "  Building AMP trainer..."
	@if command -v $(S_COMPILER) > /dev/null; then \
		$(S_COMPILER) build $(SCRIPT_DIR)/mixed_precision_trainer.s -o $(BIN_DIR)/mixed_precision_trainer 2>/dev/null || echo "    ⚠ AMP build skipped"; \
	fi

build-distributed: dirs
	@echo "  Building distributed trainer..."
	@if command -v $(S_COMPILER) > /dev/null; then \
		$(S_COMPILER) build $(SCRIPT_DIR)/distributed_training.s -o $(BIN_DIR)/distributed_training 2>/dev/null || echo "    ⚠ Distributed build skipped"; \
	fi

# ============================================
# Training Targets
# ============================================

train: build
	@echo "$(BLUE)🚀 Starting standard training...$(NC)"
	@echo "  Config: $(CONFIG_FILE)"
	@echo "  Checkpoints: $(CHECKPOINT_DIR)"
	@bash $(SCRIPT_DIR)/complete_training_cycle.sh

train-full: build
	@echo "$(BLUE)🚀 Starting FULL training cycle with all optimizations...$(NC)"
	@ENABLE_AMP=1 ENABLE_LR_SCHEDULE=1 ENABLE_GRADIENT_CLIP=1 ENABLE_MONITORING=1 \
		bash $(SCRIPT_DIR)/complete_training_cycle.sh

train-amp: build
	@echo "$(BLUE)🚀 Starting training with AMP enabled...$(NC)"
	@ENABLE_AMP=1 ENABLE_LR_SCHEDULE=1 ENABLE_GRADIENT_CLIP=1 ENABLE_MONITORING=1 \
		bash $(SCRIPT_DIR)/complete_training_cycle.sh

train-distributed: build
	@echo "$(BLUE)🚀 Starting distributed training ($(WORLD_SIZE) GPUs)...$(NC)"
	@ENABLE_DISTRIBUTED=1 WORLD_SIZE=$(WORLD_SIZE) RANK=$(RANK) \
		MASTER_ADDR=$(MASTER_ADDR) MASTER_PORT=$(MASTER_PORT) \
		bash $(SCRIPT_DIR)/complete_training_cycle.sh

train-with-profile: build
	@echo "$(BLUE)🚀 Starting training with profiling...$(NC)"
	@NEURX_PROFILE=1 bash $(SCRIPT_DIR)/complete_training_cycle.sh

# ============================================
# Demo Targets
# ============================================

demo:
	@if [ "$(ARGS)" == "all" ]; then \
		bash $(SCRIPT_DIR)/training_demo.sh all; \
	else \
		bash $(SCRIPT_DIR)/training_demo.sh; \
	fi

demo-all:
	@bash $(SCRIPT_DIR)/training_demo.sh all

demo-perplexity:
	@bash $(SCRIPT_DIR)/training_demo.sh 1

demo-amp:
	@bash $(SCRIPT_DIR)/training_demo.sh 2

demo-lr:
	@bash $(SCRIPT_DIR)/training_demo.sh 3

demo-gradient:
	@bash $(SCRIPT_DIR)/training_demo.sh 4

demo-monitor:
	@bash $(SCRIPT_DIR)/training_demo.sh 5

demo-distributed:
	@bash $(SCRIPT_DIR)/training_demo.sh 6

demo-checkpoint:
	@bash $(SCRIPT_DIR)/training_demo.sh 7

demo-report:
	@bash $(SCRIPT_DIR)/training_demo.sh 8

# ============================================
# Evaluation Targets
# ============================================

eval:
	@echo "$(BLUE)📊 Evaluating model...$(NC)"
	@if [ -f $(BIN_DIR)/evaluator ]; then \
		$(BIN_DIR)/evaluator --config $(CONFIG_FILE); \
	else \
		echo "$(YELLOW)⚠ Evaluator not built$(NC)"; \
	fi

report:
	@echo "$(BLUE)📊 Generating training report...$(NC)"
	@if [ -f "$(LOG_DIR)/training_"*.jsonl ]; then \
		echo "Latest metrics:"; \
		tail -5 $(LOG_DIR)/training_*.jsonl 2>/dev/null | $(PYTHON) -m json.tool 2>/dev/null || tail -5 $(LOG_DIR)/training_*.jsonl 2>/dev/null; \
	else \
		echo "$(YELLOW)No training logs found$(NC)"; \
	fi

analyze-ppl:
	@echo "$(BLUE)📈 Analyzing perplexity progression...$(NC)"
	@$(PYTHON) << 'EOF'
import json
import os
import sys
from pathlib import Path

log_dir = "$(LOG_DIR)"
ppl_files = sorted(Path(log_dir).glob("perplexity_*.jsonl"), reverse=True)

if not ppl_files:
    print("No perplexity data found")
    sys.exit(1)

with open(ppl_files[0], 'r') as f:
    lines = [json.loads(l) for l in f if l.strip()]

if len(lines) < 2:
    print("Insufficient data")
    sys.exit(1)

print(f"\n📊 Perplexity Analysis ({ppl_files[0].name}):\n")

initial = lines[0]['perplexity']
final = lines[-1]['val_perplexity']
best = min(l['val_perplexity'] for l in lines)
improvement = (initial - final) / initial * 100

print(f"Initial PPL:      {initial:>8.1f}")
print(f"Final PPL:        {final:>8.1f}")
print(f"Best PPL:         {best:>8.1f}")
print(f"Improvement:      {improvement:>8.2f}%")

if final < 50:
    print(f"\n✅ Claude-level perplexity achieved!")
elif final < 100:
    print(f"\n🔄 Good progress, continue training")
else:
    print(f"\n⚠️  Needs more training")

# Show trend
print(f"\nTrend (last 10 evaluations):")
for i in range(max(0, len(lines)-10), len(lines)):
    ppl = lines[i]['val_perplexity']
    bar_len = int(ppl / 10)
    bar = "█" * min(bar_len, 50)
    print(f"  {bar} {ppl:.1f}")
EOF

# ============================================
# Checkpoint Management
# ============================================

checkpoint-list:
	@echo "$(BLUE)📂 Available checkpoints:$(NC)"
	@if [ -d "$(CHECKPOINT_DIR)" ]; then \
		ls -1d $(CHECKPOINT_DIR)/checkpoint-* 2>/dev/null | sort -V | tail -10 | while read dir; do \
			step=$$(basename "$$dir" | sed 's/checkpoint-//'); \
			if [ -f "$$dir/metadata.json" ]; then \
				ppl=$$($(PYTHON) -c "import json; data=json.load(open('$$dir/metadata.json')); print(data.get('perplexity', 'N/A'))" 2>/dev/null || echo "N/A"); \
				echo "  Step $$step: PPL $$ppl"; \
			fi; \
		done; \
	else \
		echo "  $(YELLOW)No checkpoints found$(NC)"; \
	fi

checkpoint-cleanup:
	@echo "$(BLUE)🧹 Cleaning old checkpoints (keeping 5)...$(NC)"
	@bash $(SCRIPT_DIR)/integration.sh checkpoint cleanup 5
	@echo "$(GREEN)✓ Cleanup complete$(NC)"

# ============================================
# Testing & Validation
# ============================================

test: build
	@echo "$(BLUE)🧪 Running tests...$(NC)"
	@echo "  Testing data loading..."
	@[ -f "$(CONFIG_FILE)" ] && echo "    ✓ Config found" || echo "    ✗ Config missing"
	@[ -d "$(DATA_DIR)" ] && echo "    ✓ Data directory found" || echo "    ✗ Data missing"
	@echo "  Testing builds..."
	@[ -f "$(BIN_DIR)/advanced_monitor" ] && echo "    ✓ Monitor built" || echo "    ⚠ Monitor skipped"
	@[ -f "$(BIN_DIR)/mixed_precision_trainer" ] && echo "    ✓ AMP built" || echo "    ⚠ AMP skipped"
	@[ -f "$(BIN_DIR)/distributed_training" ] && echo "    ✓ Distributed built" || echo "    ⚠ Distributed skipped"
	@echo "$(GREEN)✓ Tests complete$(NC)"

# ============================================
# Status & Information
# ============================================

status:
	@echo "$(CYAN)📊 NeurX System Status:$(NC)"
	@echo "  Platform: $$(uname -s)"
	@echo "  S Compiler: $$(command -v $(S_COMPILER) || echo 'Not found')"
	@echo "  Python: $$($(PYTHON) --version)"
	@echo ""
	@echo "  Features Enabled:"
	@echo "    AMP: $(ENABLE_AMP)"
	@echo "    LR Schedule: $(ENABLE_LR_SCHEDULE)"
	@echo "    Gradient Clip: $(ENABLE_GRADIENT_CLIP)"
	@echo "    Distributed: $(ENABLE_DISTRIBUTED)"
	@echo "    Monitoring: $(ENABLE_MONITORING)"
	@echo ""
	@echo "  Build Status:"
	@ls -1 $(BIN_DIR)/ 2>/dev/null | sed 's/^/    ✓ /' || echo "    (No tools built)"

# ============================================
# Cleaning
# ============================================

clean:
	@echo "$(BLUE)🧹 Cleaning...$(NC)"
	@rm -rf $(BIN_DIR) build/
	@find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
	@find . -type f -name "*.pyc" -delete
	@echo "$(GREEN)✓ Clean complete$(NC)"

clean-all: clean
	@echo "$(BLUE)🧹 Deep cleaning...$(NC)"
	@rm -rf $(CHECKPOINT_DIR) $(LOG_DIR)
	@echo "$(GREEN)✓ Deep clean complete$(NC)"

# ============================================
# Version & Info
# ============================================

version:
	@echo "NeurX Training System v2.0"
	@echo "Features: Monitoring + Perplexity + AMP + LR Schedule + Distributed"
	@if command -v $(S_COMPILER) > /dev/null; then \
		$(S_COMPILER) --version; \
	fi

.DEFAULT_GOAL := help
