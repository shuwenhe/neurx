# neurx-code secrets configuration
# NeurX API Configuration
#
# IMPORTANT: This file is gitignored and will not be committed to version control.
# Copy this template to one of these locations:
#   - ~/.config/neurx-code/secrets.env (recommended)
#   - Project root: secrets.env (local development)
#
# neurx will load API keys from these locations in order:
#   1. Environment variables
#   2. UI Settings panel
#   3. secrets.env configuration file

# API Keys (neurx checks these in order: NEURX_API_KEY, SILICONFLOW_API_KEY, OPENAI_API_KEY)
NEURX_API_KEY=your-api-key-here
SILICONFLOW_API_KEY=your-api-key-here
OPENAI_API_KEY=your-api-key-here

# API Endpoints
NEURX_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_API_ENDPOINT=https://api.siliconflow.cn/v1/chat/completions
NEURX_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Optional alternate provider key
# ANTHROPIC_API_KEY=your-provider-key-here
